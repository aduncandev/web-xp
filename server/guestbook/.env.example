# Copy to .env and fill in. Run with: node --env-file=.env src/index.js

# --- required secrets -------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HMAC_SECRET must stay stable: changing it invalidates every outstanding
# proof-of-work challenge and re-hashes every signer, which loses your bans.
ADMIN_TOKEN=
HMAC_SECRET=

# --- server -----------------------------------------------------------------
# 8080 is taken by AMP on the target box; pick anything free.
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/guestbook.db

# Origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://aduncan.dev,http://localhost:3000

# ON when behind nginx/Caddy (so X-Forwarded-For is believed).
# OFF if this process is exposed to the internet directly — otherwise anyone
# can forge the header and walk past every rate limit and ban.
TRUST_PROXY=true

# --- moderation policy ------------------------------------------------------
# Entries scoring at or above HOLD_SCORE wait for you; at or above BLOCK_SCORE
# they are never visible to anyone.
HOLD_SCORE=3
BLOCK_SCORE=8

# false: a message containing a link is held for review, and links always
# render as plain text so spam gets no SEO value from being here.
ALLOW_LINKS=false

MAX_MESSAGE_LENGTH=800
MAX_NAME_LENGTH=32

# Messages shorter than this skip duplicate detection entirely. Short guest
# book messages ("Nice site!", "Hello!") are legitimately identical between
# different visitors, and too small to carry a spam payload.
MIN_DUPLICATE_LENGTH=40

# --- anti-bot ---------------------------------------------------------------
# Proof-of-work difficulty in leading zero bits. 18 is roughly a quarter of a
# second in a browser. Raise if you get flooded; each +1 doubles the work.
POW_BITS=18
MIN_FILL_SECONDS=3
PER_IP_PER_HOUR=3
PER_IP_PER_DAY=8
GLOBAL_PER_HOUR=120

# --- Claude classifier (OPTIONAL, the only part that costs money) --------
# Leave ANTHROPIC_API_KEY empty and this layer is simply off: the pattern,
# structural, proof-of-work, rate-limit and duplicate layers all still run.
# Turn it on for the case those cannot cover — an entry that is polite,
# correctly spelled, on no keyword list, and still advertising something
# illegal.
#
# Cost per entry is roughly 600 input + 300 output tokens. On Haiku 4.5
# that is about $0.002 — a hundred entries a month is about 20 cents. The
# real risk was never normal traffic but a flood, which is what the daily
# cap below bounds: at 200/day on Haiku the worst case is about $0.40/day,
# and past the cap entries are held for review rather than published.
ANTHROPIC_API_KEY=

# Defaults to on when a key is present, off when it is not.
# CLASSIFIER_ENABLED=true

# claude-haiku-4-5 is the default and the right tier for this. Note that
# CLASSIFIER_EFFORT only applies to the Opus/Sonnet-5 tiers — Haiku 4.5
# rejects the parameter, so it is omitted automatically for that model.
CLASSIFIER_MODEL=claude-haiku-4-5
CLASSIFIER_EFFORT=low
CLASSIFIER_TIMEOUT_MS=12000

# Hard ceiling on paid calls per day. Past it, entries are held.
CLASSIFIER_MAX_PER_DAY=200

# false = if the classifier cannot answer, hold the entry instead of
# publishing it. An outage becomes a queue, not an open wall.
CLASSIFIER_FAIL_OPEN=false

# --- Discord ----------------------------------------------------------------
# A bot token + channel id gets you alerts WITH approve/reject/delete/ban
# buttons. A plain webhook URL alone still delivers alerts, but Discord drops
# the buttons — components can only come from an application.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# Discord user IDs allowed to moderate. A valid signature only proves the
# click came from Discord, not that the clicker is you — this is the check
# that matters. Empty means nothing can be actioned from Discord at all.
DISCORD_MODERATOR_IDS=

# Your public origin. Only used so scripts/check-discord.js can print the
# exact Interactions Endpoint URL to paste into the Discord portal.
PUBLIC_BASE_URL=https://aduncan.dev/gb

# Ping on every entry, or only the ones needing a decision.
DISCORD_NOTIFY_ON_PUBLISHED=true

# --- retention (days, 0 disables) -------------------------------------------
RETAIN_RAW_IP_DAYS=30
RETAIN_REJECTED_DAYS=30
RETAIN_ATTEMPTS_DAYS=7
